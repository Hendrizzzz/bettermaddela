{
  "name": "bettermaddela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/clean-output.mjs && next build",
    "typecheck": "tsc --noEmit --incremental false",
    "check:repository": "node scripts/check-repository.mjs",
    "audit:inherited": "node scripts/check-repository.mjs --audit-inherited",
    "validate:data": "node scripts/validate-civic-data.mjs",
    "test:accessibility": "node scripts/check-accessibility.mjs",
    "verify": "bun run check:repository && bun run audit:inherited && bun run validate:data && bun run typecheck && bun run build && bun run test:accessibility"
  },
  "dependencies": {
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
}
